line-block;min-width:52px;text-align:center;padding:3px 6px;border-radius:5px;font-size:10px;background:#f5f5f5;margin:2px 4px 2px 0;'> Temp<br/><b>15&deg; a 15.4&deg;C</b></span><span style='display:inline-block;min-width:52px;text-align:center;padding:3px 6px;border-radius:5px;font-size:10px;background:#f5f5f5;margin:2px 4px 2px 0;'> Viento<br/><b>48 km/h</b></span></div></div><div style='border-left:5px solid #27c93f;background:#f7f7f7;border-radius:6px;padding:8px 10px;margin-bottom:6px;'><div style='display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;'><b style='font-size:13px;'>+6 a 12h</b><span style='background:#27c93f;color:#000;font-size:10px;font-weight:bold;padding:2px 8px;border-radius:10px;'>Sin alerta</span></div><div style='display:flex;flex-wrap:wrap;gap:4px;font-size:11px;'><span style='display:inline-block;min-width:52px;text-align:center;padding:3px 6px;border-radius:5px;font-size:10px;background:#f5f5f5;margin:2px 4px 2px 0;'> ECMWF<br/><b>0.1 mm</b></span><span style='display:inline-block;min-width:52px;text-align:center;padding:3px 6px;border-radius:5px;font-size:10px;background:#f5f5f5;margin:2px 4px 2px 0;'> GFS<br/><b>0 mm</b></span><span style='display:inline-block;min-width:52px;text-align:center;padding:3px 6px;border-radius:5px;font-size:10px;background:#f5f5f5;margin:2px 4px 2px 0;'> ICON<br/><b>0.4 mm</b></span><span style='display:inline-block;min-width:52px;text-align:center;padding:3px 6px;border-radius:5px;font-size:10px;background:#f5f5f5;margin:2px 4px 2px 0;'> Isoterma<br/><b>3010 m</b></span><span style='display:inline-block;min-width:52px;text-align:center;padding:3px 6px;border-radius:5px;font-size:10px;background:#f5f5f5;margin:2px 4px 2px 0;'> Temp<br/><b>15&deg; a 15.3&deg;C</b></span><span style='display:inline-block;min-width:52px;text-align:center;padding:3px 6px;border-radius:5px;font-size:10px;background:#f5f5f5;margin:2px 4px 2px 0;'> Viento<br/><b>39 km/h</b></span></div></div><div style